{
  "name": "appium-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Appium 2 and WebdriverIO framework for Sauce Labs My Demo App on Android.",
  "license": "MIT",
  "author": "Hassan Mehmood",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassanmehmoodd/appium-mobile-automation.git"
  },
  "scripts": {
    "app:download": "node scripts/download-apk.mjs",
    "appium:setup": "bash scripts/install-driver.sh",
    "emulator:start": "bash scripts/start-emulator.sh",
    "test": "wdio run config/wdio.local.conf.ts",
    "test:smoke": "wdio run config/wdio.local.conf.ts --suite smoke",
    "test:regression": "wdio run config/wdio.local.conf.ts --suite regression",
    "test:tag:smoke": "MOCHA_GREP=@smoke wdio run config/wdio.local.conf.ts",
    "test:tag:regression": "MOCHA_GREP=@regression wdio run config/wdio.local.conf.ts",
    "test:ci": "wdio run config/wdio.ci.conf.ts",
    "test:smoke:ci": "wdio run config/wdio.ci.conf.ts --suite smoke",
    "test:kobiton": "wdio run config/wdio.kobiton.conf.ts --suite smoke",
    "test:kobiton:regression": "wdio run config/wdio.kobiton.conf.ts --suite regression",
    "test:browserstack": "wdio run config/wdio.browserstack.conf.ts --suite smoke",
    "test:sauce": "wdio run config/wdio.sauce.conf.ts --suite smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^9.33.1",
    "@wdio/appium-service": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/types": "^9.33.1",
    "allure-commandline": "^2.46.1",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
