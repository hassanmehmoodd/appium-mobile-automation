# Copy to .env for local runs. Never commit real secrets.

# Android emulator started by scripts/start-emulator.sh
ANDROID_HOME=
ANDROID_SDK_ROOT=
AVD_NAME=mda_api_34
ANDROID_UDID=

# Official Sauce Labs My Demo App release. Overriding the URL is optional.
APK_URL=https://github.com/saucelabs/my-demo-app-android/releases/download/2.3.0/mda-2.3.0-27.apk
APK_PATH=apps/mda-2.3.0-27.apk

# Set to 1 to write docs/screenshots during a run.
DOCS_SCREENSHOTS=0

# Kobiton. The suite exits 0 when either value is empty.
# https://docs.kobiton.com/automation-testing/basic-appium-server/launch-a-basic-appium-2-session
KOBITON_USERNAME=
KOBITON_API_KEY=
KOBITON_DEVICE_NAME=
KOBITON_DEVICE_GROUP=KOBITON
KOBITON_APP_URL=

# BrowserStack and Sauce Labs stay off unless the matching flag is true.
ENABLE_BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_URL=
BROWSERSTACK_DEVICE_NAME=Google Pixel 7
BROWSERSTACK_PLATFORM_VERSION=13.0

ENABLE_SAUCE=false
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_APP=
SAUCE_DEVICE_NAME=Google Pixel 7 GoogleAPI Emulator
SAUCE_PLATFORM_VERSION=14
SAUCE_REGION=us-west-1
